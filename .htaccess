# =========================
# Seguridad y limpieza
# =========================
Options -Indexes
RewriteEngine On

# -------------------------
# 1. Redirigir carpetas sin index "por capas"
# -------------------------
# Si es una carpeta
RewriteCond %{REQUEST_FILENAME} -d
# Y no tiene index.php ni index.html
RewriteCond %{REQUEST_FILENAME}/index.php !-f
RewriteCond %{REQUEST_FILENAME}/index.html !-f
# Redirige a la carpeta superior
RewriteRule ^(.*/)?[^/]+/?$ /$1 [R=302,L]

# -------------------------
# 2. Proteger carpeta admin
# -------------------------
# Redirige cualquier acceso directo a /admin que no sea index.php
RewriteCond %{REQUEST_URI} ^/home/admin/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^home/admin/ /home/logout.php [R=302,L]

# -------------------------
# 3. Opcional: ocultar extensiones .php
# -------------------------
# Puedes acceder a login.php como /login
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L]

# =========================
# Fin del .htaccess
# =========================